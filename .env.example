# Copy to .env.local and fill in real values. Never commit .env.local.

# Required: the AI that writes queries and stories.
ANTHROPIC_API_KEY=

# Shared store for limits and the answer cache (set automatically by the
# Upstash integration on Vercel). Without it, limits are per server instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Limits (defaults shown).
# ASK_MONTHLY_BUDGET_USD=40
# ASK_DAILY_TOTAL=30
# ASK_DAILY_PER_VISITOR=5
# Random strings: signs question tokens; unlocks /api/data/status and pre-computing.
# ASK_TOKEN_SECRET=
# ASK_ADMIN_TOKEN=
# Model for live questions (default claude-sonnet-5-5).
# ASK_MODEL=
