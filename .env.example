# Copy to .env.local and fill in real values. Never commit .env.local.

# Required for the /api/ask RAG endpoint (answer generation).
ANTHROPIC_API_KEY=

# Optional: overrides the default Claude model used for answer synthesis
# (defaults to claude-haiku-4-5-20251001 to keep per-query cost low).
# ANTHROPIC_MODEL=claude-sonnet-5

# Required for scripts/embed.mjs (embedding the corpus) and for the
# /api/ask endpoint (embedding the visitor's question at query time).
VOYAGE_API_KEY=

# ---- Data portals (/api/data/*, see ARCHITECTURE.md) ----
# Shared store for limits and the answer cache (set automatically by the
# Upstash integration on Vercel). Without it, limits are per server instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Limits (defaults shown).
# ASK_MONTHLY_BUDGET_USD=40
# ASK_DAILY_TOTAL=30
# ASK_DAILY_PER_VISITOR=5
# Random strings: signs question tokens; unlocks /api/data/status and pre-computing.
# ASK_TOKEN_SECRET=
# ASK_ADMIN_TOKEN=
# Model for live questions (default claude-sonnet-5-5).
# ASK_MODEL=
