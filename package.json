{
  "name": "security-advisory-search",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run portals && next dev",
    "build": "npm run portals && next build",
    "start": "next start",
    "ingest:security": "node scripts/ingest-security.mjs",
    "ingest:governance": "node scripts/ingest-governance.mjs",
    "embed:security": "node --env-file=.env.local scripts/embed.mjs security",
    "embed:governance": "node --env-file=.env.local scripts/embed.mjs governance",
    "portals": "node scripts/build-portals.mjs"
  },
  "dependencies": {
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
